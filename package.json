{
  "name": "3d-necklace-designer",
  "version": "1.0.0",
  "type": "module",
  "description": "Web-based 3D hip-hop necklace designer with custom text pendants",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/pack-meshes.js && node scripts/precompress.js",
    "preview": "vite preview",
    "start": "node server.js",
    "test": "node --test test/*.test.js",
    "smoke": "node scripts/smoke.js",
    "check-live": "node scripts/check-live.js",
    "font-previews": "node scripts/font-previews.js"
  },
  "dependencies": {
    "express": "^4.21.0",
    "stripe": "^17.0.0",
    "three": "^0.170.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "opentype.js": "^1.3.4",
    "vite": "^6.0.0"
  }
}
