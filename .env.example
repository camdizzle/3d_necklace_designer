# Chain Studio — Required Environment Variables
# Copy this file to .env and fill in your values.

# Stripe (required for orders)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Admin dashboard
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Owner export bypass — visit /design/#bypass=<key> to skip the $2 export payment
ADMIN_BYPASS_KEY=change-me-to-a-random-string

# Email notifications (Resend)
EMAIL_API_KEY=re_...
EMAIL_FROM=orders@yourdomain.com

# App
BASE_URL=https://hypechain.c23d.shop
# Shown on the terms/privacy/refund pages (defaults to EMAIL_FROM)
CONTACT_EMAIL=support@yourdomain.com
# Old hostnames that should 301 to BASE_URL (comma-separated)
LEGACY_HOSTS=designer.camwow.tv
PORT=3000
